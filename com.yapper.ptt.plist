<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yapper.ptt</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/yapper</string>
        <string>-model=/usr/local/share/yapper/ggml-base.en.bin</string>
        <string>-hotkey=rightoption</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/yapper.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/yapper.err</string>
</dict>
</plist>
